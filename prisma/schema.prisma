// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password String @unique
  target Target
  fitstName      String @db.VarChar(100) @map("first_name")
  lastName      String @db.VarChar(100)  @map("last_name")
  position Position[]
  skills Skill[] 
  phone String @db.VarChar(20)
  linkedin String?
  slack String?
  telegram String?
  scheduleStart String @map("schedule_start")
  scheduleEnd String @map("schedule_end")
  userStartDate DateTime @default(now()) @map("user_start_date")
  growthPlan String? @db.Text @map("growth_plan")
  experience String? @db.Text
  userPhoto String? @db.VarChar(255) @map("user_photo")
  projects Project[] 
   isVerified Boolean @default(false) @map("is_verified")
   isAdmin Boolean @default(false) @map("is_admin")

 writtenReviews  Review[] @relation("Author")  // Отзывы, которые пользователь написал
  receivedReviews Review[] @relation("Reviewed")  // Отзывы, которые написали про него
  
 @@map("users") 
}

enum Target {
TRAINEE
MENTOR
PARTNER

@@map("target")
}

model Position {
id        Int     @id @default(autoincrement())
name     String  @db.VarChar(100) @map("position_name") 
category String @db.VarChar(100)
users    User[] 
  project Project[]

  @@map("positions")
}

model Skill {
id        Int     @id @default(autoincrement())
name     String  @db.VarChar(100) @map("skill_name") 
users    User[]
project Project[]

  @@map("skills")
}

model Project {
id        Int     @id @default(autoincrement())
name     String  @db.VarChar(100) @map("project_name") 
photo String? @db.VarChar(100) @map("project_photo") 
shortDescription String? @db.VarChar(100) @map("short_description") 
description String? @db.Text  
goals String
projectStartDate DateTime @default(now()) @map("project_start_date")
deadline DateTime?
sectorId Int
sector  Sector @relation(fields: [sectorId], references: [id])
stakeholder Stakeholder[]
skills Skill[]
users    User[]
positions Position[]
projectStatus ProjectStatus

  @@map("projects")
}

enum ProjectStatus {
unstaffed    //Неукомплектований
	staffed   //Укомплектований
	blocked    //Заблокований
	frozen   //Заморожений
	completed   //Завершений
}

model Stakeholder {
id        Int     @id @default(autoincrement())
email     String  @unique
fitstName      String @db.VarChar(100) @map("first_name_stakeholder")
 lastName      String @db.VarChar(100)  @map("last_name_stakeholder")
  phone String @db.VarChar(20) @map("phone_stakeholder")
  userStakeholder String? @db.VarChar(255) @map("user_stakeholder")
projects Project[] 

  @@map("stakeholders")
}

model Sector {
id        Int     @id @default(autoincrement())
name     String  @db.VarChar(100) @map("sector_name") 
projects Project[] 

  @@map("sectors")
}

model Review {
  id        Int     @id @default(autoincrement())
  text String @db.Text @map("text_review")
  author     User       @relation("Author", fields: [authorId], references: [id])
  authorId   Int

  reviewedUser User @relation("Reviewed", fields: [reviewedUserId], references: [id]) // На кого отзыв
  reviewedUserId Int

@@map("reviews")
}